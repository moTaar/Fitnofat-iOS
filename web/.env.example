# ── Supabase (the database + auth the app talks to directly) ─────────────────
# Project Settings → API. The anon key is safe to ship in the app: every table
# is protected by row-level security (see supabase/migrations/native_client_access.sql).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Hosted services (only for AI, billing and account admin) ────────────────
# Base URL of the Fitnofat data API — Gemini-backed features only.
# Local dev points at the local Express server:
VITE_API_URL=http://localhost:8080

# Base URL of the accounts microservice (sign-up, email/password change,
# account deletion, Stripe billing).
VITE_ACCOUNTS_URL=http://localhost:8090

# ── iOS app ──────────────────────────────────────────────────────────────────
# Custom URL scheme the app registers (must match CFBundleURLSchemes in
# ios/App/App/Info.plist). Password-reset emails link to <scheme>://reset-password,
# so add that URL to Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_APP_URL_SCHEME=fitnofat

# Days of history pulled on a cold start (older sessions load on demand and
# then stay on the device).
# VITE_BOOTSTRAP_HISTORY_DAYS=120
