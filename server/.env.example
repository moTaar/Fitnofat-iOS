# ── Server config ────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — KEEP SECRET, server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini (optional) ─────────────────────────────────────────────────────────
# Leave blank to use the built-in local program generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── YouTube demo videos (optional) ────────────────────────────────────────────
# Google Cloud console → enable "YouTube Data API v3" → create an API key.
# Leave blank to disable the exercise demo picker (the written how-to guide
# still renders on its own).
YOUTUBE_API_KEY=
# search.list costs 100 of a default 10,000 units/day — a GLOBAL allowance
# shared by every user, i.e. ~100 searches per day for the whole service.
# Results are cached per movement forever, so steady-state use is near zero,
# but this cap is what stops a cold cache burning the day in an hour.
# Raising it past ~99 without an approved quota increase just moves the failure
# from our meter to Google's.
YOUTUBE_DAILY_BUDGET=90
# Comma-separated channel IDs (UC…) promoted to the top of every result set.
# The cheapest quality lever in the feature — costs no extra quota and turns
# "whatever relevance returned" into coaches you've vetted.
YOUTUBE_CHANNEL_ALLOWLIST=
YOUTUBE_REGION=US
YOUTUBE_RELEVANCE_LANGUAGE=en
