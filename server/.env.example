# ── Server config ────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — KEEP SECRET, server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini (optional) ─────────────────────────────────────────────────────────
# Leave blank to use the built-in local program generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

<<<<<<< HEAD
# ── Medical AI (AI nutritionist + medical helper) ─────────────────────────────
# Which backend answers medical questions:
#   auto     — first configured of cloudrun → vertex → gemini (default)
#   cloudrun — a model you host yourself behind an OpenAI-compatible API
#              (MedGemma on Cloud Run: see wiki/MedGemma-Cloud-Run-Deployment.md)
#   vertex   — Vertex AI, inside your own GCP project, under your IAM
#   gemini   — the shared Gemini API endpoint
MEDICAL_AI_PROVIDER=auto

# ── Self-hosted medical model (MEDICAL_AI_PROVIDER=cloudrun) ──────────────────
# Base URL INCLUDING the version path. Setting this is what turns cloudrun on.
MEDICAL_AI_BASE_URL=
# Model name the server expects in the request body — vLLM's --served-model-name.
MEDICAL_AI_SELF_HOSTED_MODEL=medgemma-1.5-4b-it
# Only for a self-hosted endpoint that is NOT on Cloud Run. On Cloud Run leave
# this blank: the service-account key below mints a short-lived, audience-scoped
# ID token instead, which is the better credential.
MEDICAL_AI_API_KEY=
# Vertex publisher model id. A `gemini-*` id uses the modern request shape; a
# `medlm-*` id uses the PaLM-era one. Google retired MedLM (the productized
# Med-PaLM 2) on 2025-09-29, so those ids no longer resolve — set this to a
# medical-tuned publisher model only if your project actually serves one.
# Defaults to GEMINI_COACH_MODEL.
MEDICAL_AI_MODEL=
# Model used when the request runs on the Gemini provider (fallback or forced).
# Defaults to GEMINI_COACH_MODEL.
MEDICAL_AI_GEMINI_MODEL=
MEDICAL_AI_TIMEOUT_MS=90000
# Daily allowance for medical AI calls. Free is 0 — the feature is Pro-gated.
QUOTA_MEDICAL_FREE=0
QUOTA_MEDICAL_PRO=60

# ── Google service account (needed for vertex AND for Cloud Run auth) ─────────
# Vertex uses OAuth, not an API key: create a service account with the
# roles/aiplatform.user role and paste its key JSON below (raw or base64), or
# point GOOGLE_APPLICATION_CREDENTIALS at the key file instead.
# Google renamed the product to "Gemini Enterprise Agent Platform" in April
# 2026, so searching the console API Library for "vertex" finds nothing. The
# service name is unchanged — enable it directly at
# https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
# VERTEX_PROJECT_ID is optional; it defaults to the key JSON's own project_id.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_SERVICE_ACCOUNT_JSON=
=======
# ── YouTube demo videos (optional) ────────────────────────────────────────────
# Google Cloud console → enable "YouTube Data API v3" → create an API key.
# Leave blank to disable the exercise demo picker (the written how-to guide
# still renders on its own).
YOUTUBE_API_KEY=
# search.list costs 100 of a default 10,000 units/day — a GLOBAL allowance
# shared by every user, i.e. ~100 searches per day for the whole service.
# Results are cached per movement forever, so steady-state use is near zero,
# but this cap is what stops a cold cache burning the day in an hour.
# Raising it past ~99 without an approved quota increase just moves the failure
# from our meter to Google's.
YOUTUBE_DAILY_BUDGET=90
# Comma-separated channel IDs (UC…) promoted to the top of every result set.
# The cheapest quality lever in the feature — costs no extra quota and turns
# "whatever relevance returned" into coaches you've vetted.
YOUTUBE_CHANNEL_ALLOWLIST=
YOUTUBE_REGION=US
YOUTUBE_RELEVANCE_LANGUAGE=en
