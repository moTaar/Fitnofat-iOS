# ── Server config ────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — KEEP SECRET, server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini (optional) ─────────────────────────────────────────────────────────
# Leave blank to use the built-in local program generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Medical AI (AI nutritionist + medical helper) ─────────────────────────────
# Which backend answers medical questions:
#   auto   — Vertex AI when the credentials below are set, else Gemini (default)
#   vertex — force Vertex AI (Med-PaLM lineage: MedLM and its successors)
#   gemini — force the general Gemini model
MEDICAL_AI_PROVIDER=auto
# Vertex publisher model id. `medlm-medium` / `medlm-large` are the productized
# Med-PaLM 2 models; a `gemini-*` id here is called with the Gemini request
# shape instead. Availability is per Google Cloud project — check yours.
MEDICAL_AI_MODEL=medlm-medium
# Model used when the request runs on the Gemini provider (fallback or forced).
# Defaults to GEMINI_COACH_MODEL.
MEDICAL_AI_GEMINI_MODEL=
MEDICAL_AI_TIMEOUT_MS=90000
# Daily allowance for medical AI calls. Free is 0 — the feature is Pro-gated.
QUOTA_MEDICAL_FREE=0
QUOTA_MEDICAL_PRO=60

# ── Vertex AI credentials (only needed for MEDICAL_AI_PROVIDER=vertex/auto) ───
# Vertex uses OAuth, not an API key: create a service account with the
# "Vertex AI User" role and paste its key JSON below (raw or base64), or point
# GOOGLE_APPLICATION_CREDENTIALS at the key file instead.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_SERVICE_ACCOUNT_JSON=
