# ── Accounts service config ──────────────────────────────────────────────────
PORT=8090
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Where the web app lives — used for Stripe Checkout success/cancel redirects.
APP_URL=http://localhost:5173

# ── Supabase (Project Settings → API) — same project as the data API ─────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — KEEP SECRET, server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (Dashboard → Developers → API keys) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local: `stripe listen --forward-to localhost:8090/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price ID for the Pro tier (Stripe → Products → your price).
STRIPE_PRICE_PRO=price_...

# ── Admin API ─────────────────────────────────────────────────────────────────
# Secret key that gates all /admin/* endpoints. Keep this out of any client code.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
